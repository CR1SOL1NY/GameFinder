# Solo para el backend alojado. Configurar valores privados en el proveedor.
# No utilizar el usuario exclusivo de gamefinder_pruebas.
MONGODB_URI=
MONGO_DB_NAME=GameFinder
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=production
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Reemplazar por los dominios HTTPS reales, separados por coma. No usar *.
CORS_ORIGINS=https://gamefinder-web.example.com
# Railway/Render proporcionan PORT automáticamente; no hace falta fijarlo.
