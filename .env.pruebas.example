# Archivo separado del .env de la aplicación. Nunca compartir ni subir la URI real.
# Copiar como .env.pruebas. Usuario Atlas con readWrite SOLO en esta base vacía.
# Pegar la URI SRV de Atlas sin /GameFinder; nunca reutilizar credenciales del producto.
MONGODB_PRUEBAS_URI=
MONGODB_PRUEBAS_DB=gamefinder_pruebas
